// ══════════════════════════════════════════════
// WAYBAR CONFIG — bản "rice" hoàn chỉnh
// Icon dùng glyph Nerd Font (không emoji) — nhiều module đổi icon
// theo % thật (volume/battery), không phải icon tĩnh.
// ══════════════════════════════════════════════
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "idle_inhibitor"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory", "pulseaudio", "network", "battery", "tray", "custom/power"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "default": "○",
            "active": "●"
        }
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "\uf06e",     // fa-eye — đang chặn tự khoá máy
            "deactivated": "\uf070"    // fa-eye-slash — bình thường
        }
    },

    "clock": {
        "format": "{:%H:%M  %d/%m/%Y}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },

    "cpu": {
        "format": "\uf2db {usage}%",   // fa-microchip
        "interval": 3
    },

    "memory": {
        "format": "\uf538 {percentage}%",   // fa-memory
        "tooltip-format": "{used:0.1f}GB / {total:0.1f}GB"
    },

    // Icon đổi theo % volume thật: thấp → vừa → cao (chia đều theo mảng)
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\uf6a9 Tắt tiếng",   // fa-volume-mute
        "format-icons": {
            "default": ["\uf026", "\uf027", "\uf028"]   // volume-off/down/up theo mức %
        },
        "on-click": "pavucontrol"
    },

    // Vạch tín hiệu kiểu thanh cao thấp — hiện đúng cường độ WiFi thật,
    // không cần font đặc biệt (render đúng ở mọi font monospace)
    "network": {
        "format-wifi": "{icon} {signalStrength}%",
        "format-ethernet": "\uf796 {ipaddr}",   // fa-ethernet
        "format-disconnected": "Không có mạng",
        "format-icons": ["▂", "▄", "▆", "█"],
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    // Icon pin đổi theo đúng % thật: rỗng → 1/4 → nửa → 3/4 → đầy
    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "\uf0e7 {capacity}%",   // fa-bolt khi đang sạc
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "states": {
            "warning": 20,
            "critical": 10
        }
    },

    "tray": {
        "spacing": 8
    },

    "custom/power": {
        "format": "\uf011",   // fa-power-off
        "on-click": "wlogout",
        "tooltip": false
    }
}
