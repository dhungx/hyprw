// ══════════════════════════════════════════════
// WAYBAR CONFIG — bản "rice" hoàn chỉnh
// Icon Nerd Font, đã đối chiếu trực tiếp với dữ liệu gốc
// github.com/ryanoasis/nerd-fonts (glyph-names.json / cheat sheet chính thức)
// — không dùng icon đoán từ trí nhớ.
// ══════════════════════════════════════════════
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "idle_inhibitor"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory", "pulseaudio", "network", "battery", "tray", "custom/power"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "default": "○",
            "active": "●"
        }
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "\uf06e",     // nf-fa-eye
            "deactivated": "\uf070"    // nf-fa-eye_slash
        }
    },

    "clock": {
        "format": "{:%H:%M  %d/%m/%Y}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },

    "cpu": {
        "format": "\uf2db {usage}%",   // nf-fa-microchip
        "interval": 3
    },

    "memory": {
        "format": "\uefc5 {percentage}%",   // nf-fa-memory (đã sửa, mã cũ f538 sai)
        "tooltip-format": "{used:0.1f}GB / {total:0.1f}GB"
    },

    // Icon đổi theo % volume thật: thấp → vừa → cao
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\ueee8 Tắt tiếng",   // nf-fa-volume_xmark (đã sửa, mã cũ f6a9 sai)
        "format-icons": {
            "default": ["\uf026", "\uf027", "\uf028"]   // volume_off/down/up
        },
        "on-click": "pavucontrol"
    },

    // Vạch tín hiệu WiFi kiểu thanh cao thấp — không phụ thuộc font đặc biệt,
    // đổi đúng theo cường độ tín hiệu thật ở mọi font monospace
    "network": {
        "format-wifi": "{icon} {signalStrength}%",
        "format-ethernet": "\uef44 {ipaddr}",   // nf-fa-ethernet (đã sửa, mã cũ f796 sai)
        "format-disconnected": "Không có mạng",
        "format-icons": ["▂", "▄", "▆", "█"],
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    // Icon pin đổi theo đúng % thật: rỗng → 1/4 → nửa → 3/4 → đầy
    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "\uf0e7 {capacity}%",   // nf-fa-bolt khi đang sạc
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "states": {
            "warning": 20,
            "critical": 10
        }
    },

    "tray": {
        "spacing": 8
    },

    "custom/power": {
        "format": "\uf011",   // nf-fa-power_off
        "on-click": "wlogout",
        "tooltip": false
    }
}
