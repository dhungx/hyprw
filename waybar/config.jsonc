// ══════════════════════════════════════════════
// WAYBAR CONFIG — bản "gọn động" (hover-to-reveal)
// Dùng tính năng "drawer" CHÍNH THỨC của waybar cho group module
// (xem: man waybar, mục "group"). Waybar tự vẽ animation trượt bằng
// GtkRevealer nội bộ — KHÔNG cần CSS keyframes, KHÔNG cần script/daemon
// phụ, KHÔNG tốn thêm tài nguyên đáng kể so với hiện đủ số liệu luôn.
//
// Mỗi cụm (clock/cpu/memory/pulseaudio/network/battery) giờ là 1
// "group" gồm 2 phần tử: "#short" (luôn hiện) và "#full" (ẩn, chỉ
// trượt ra khi hover đúng cụm đó).
// ══════════════════════════════════════════════
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "idle_inhibitor"],
    "modules-center": ["group/clock-drawer"],
    "modules-right": [
        "group/cpu-drawer",
        "group/mem-drawer",
        "group/vol-drawer",
        "group/net-drawer",
        "group/bat-drawer",
        "tray",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "default": "○",
            "active": "●"
        }
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "\uf06e",
            "deactivated": "\uf070"
        }
    },

    // ══ Đồng hồ: gọn (giờ:phút) -> hover trượt ra thứ, ngày/tháng/năm ══
    "group/clock-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 350,
            "children-class": "drawer-hidden"
        },
        "modules": ["clock#short", "clock#full"]
    },
    "clock#short": {
        "format": "{:%H:%M}",
        "tooltip": false
    },
    "clock#full": {
        "format": "{:%A, %d/%m/%Y}",
        "tooltip": false
    },

    // ══ CPU: chỉ icon -> hover hiện % + tần số trung bình ══
    "group/cpu-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "children-class": "drawer-hidden"
        },
        "modules": ["cpu#short", "cpu#full"]
    },
    "cpu#short": {
        "format": "\uf2db",   // nf-fa-microchip
        "interval": 3,
        "tooltip": false
    },
    "cpu#full": {
        "format": "{usage}% · {avg_frequency:0.1f}GHz",
        "interval": 3,
        "tooltip": false
    },

    // ══ RAM: chỉ icon -> hover hiện used/total GB ══
    "group/mem-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "children-class": "drawer-hidden"
        },
        "modules": ["memory#short", "memory#full"]
    },
    "memory#short": {
        "format": "\uefc5",   // nf-fa-memory
        "tooltip": false
    },
    "memory#full": {
        "format": "{used:0.1f}GB / {total:0.1f}GB",
        "tooltip": false
    },

    // ══ Âm lượng: icon đổi theo mức thật -> hover hiện số % ══
    "group/vol-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "children-class": "drawer-hidden"
        },
        "modules": ["pulseaudio#short", "pulseaudio#full"]
    },
    "pulseaudio#short": {
        "format": "{icon}",
        "format-muted": "\ueee8",
        "format-icons": {
            "default": ["\uf026", "\uf027", "\uf028"]
        },
        "tooltip": false
    },
    "pulseaudio#full": {
        "format": "{volume}%",
        "format-muted": "Tắt tiếng",
        "on-click": "pavucontrol",
        "tooltip": false
    },

    // ══ Mạng: icon sóng đổi theo cường độ thật -> hover hiện tên WiFi + % ══
    "group/net-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "children-class": "drawer-hidden"
        },
        "modules": ["network#short", "network#full"]
    },
    "network#short": {
        "format-wifi": "{icon}",
        "format-ethernet": "\uef44",
        "format-disconnected": "󰤭",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip": false
    },
    "network#full": {
        "format-wifi": "{essid} {signalStrength}%",
        "format-ethernet": "{ipaddr}",
        "format-disconnected": "Mất mạng",
        "tooltip": false
    },

    // ══ Pin: icon đổi theo % thật -> hover hiện % + thời gian còn lại ══
    "group/bat-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "children-class": "drawer-hidden"
        },
        "modules": ["battery#short", "battery#full"]
    },
    "battery#short": {
        "format": "{icon}",
        "format-charging": "\uf0e7",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "states": { "warning": 20, "critical": 10 },
        "tooltip": false
    },
    "battery#full": {
        "format": "{capacity}%",
        "format-charging": "{capacity}% · đang sạc",
        "format-time": "{H}h{M}p",
        "states": { "warning": 20, "critical": 10 },
        "tooltip": false
    },

    "tray": {
        "spacing": 8
    },

    "custom/power": {
        "format": "\uf011",
        "on-click": "wlogout",
        "tooltip": false
    }
}
